# Copy to .env.local (gitignored) and fill in. Never commit real values — if a secret reaches git
# history, revoke and reissue it: deleting the line does not remove it from history. In production
# these live in Vercel env vars.
#
# DATABASE_URL is deliberately absent here: in the devcontainer it comes from the process env
# (.devcontainer/docker-compose.yml), so there is exactly ONE source for it and the Prisma CLI and
# the app can never disagree. Set it here only if you target a database other than the compose one:
#   DATABASE_URL="postgresql://postgres:finly_dev@postgres:5030/finly_development"

# Clerk — required. The app does not boot without these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenAI — transaction auto-categorisation.
OPENAI_API_KEY=

# Upstash Redis — hosted; there is no local equivalent (the client speaks Upstash's REST API).
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Vercel Blob — statement upload storage.
BLOB_READ_WRITE_TOKEN=

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Cron Jobs Secret
CRON_SECRET=

# Application — matches the port scheme in .devcontainer/docker-compose.yml.
NEXT_PUBLIC_APP_URL=http://localhost:5010

# Playwright E2E — only needed to run the suite (npm run test).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
